# SMTP-настройки (пример для Yandex)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@yandex.ru
SMTP_PASS=your_app_password

# От кого приходит письмо
SMTP_FROM=Альфа-Банк <your@yandex.ru>

# Порт локального сервера
PORT=3456

# SQLite-база для логов формы (опционально)
DATABASE_PATH=./submissions.db
