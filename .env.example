# SMTP-настройки (пример для Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# От кого приходит письмо
SMTP_FROM=Альфа-Банк <your@gmail.com>

# Порт и интерфейс (Railway задаёт PORT сам)
PORT=3456
HOST=0.0.0.0

# SQLite-база для логов формы
# Локально: ./submissions.db
# Railway + Volume: /data/submissions.db
DATABASE_PATH=./submissions.db

# Доступ к GET /api/submissions (HTTP Basic Auth)
SUBMISSIONS_USER=admin
SUBMISSIONS_PASSWORD=KSO_DEMO_DAY_LOGS
